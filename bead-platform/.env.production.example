# Production Environment Variables
# IMPORTANT: Never commit the actual .env file - this is a template

# Database Configuration
DATABASE_URL=postgresql://bead_user:YOUR_STRONG_PASSWORD@db-prod.example.com:5432/bead
DB_PASSWORD=YOUR_STRONG_PASSWORD

# Application Security
SECRET_KEY=YOUR_RANDOM_SECRET_KEY_GENERATE_WITH_OPENSSL

# Base44 / Frontend Configuration
VITE_BASE44_APP_ID=your_production_app_id
VITE_BASE44_APP_BASE_URL=https://bead-it.org/api
BASE44_APP_ID=69af8d88bb1d923c34fa8f05
BASE44_API_KEY=your_base44_api_key
BASE44_API_BASE_URL=https://base44.com
NEXT_PUBLIC_API_URL=https://bead-it.org/api
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token
NEXT_PUBLIC_POWERBI_EMBED_URL=your_powerbi_url

# Server Configuration
DEBUG=false
NODE_ENV=production

# Azure AD auth (Phase 2)
AUTH_ENABLED=true
AZURE_AD_TENANT_ID=your_tenant_id
AZURE_AD_CLIENT_ID=your_api_app_registration_client_id
AZURE_AD_AUDIENCE=api://your-api-app-id-uri-or-client-id
AZURE_AD_ISSUER=https://login.microsoftonline.com/your_tenant_id/v2.0
AZURE_AD_OPENID_CONFIG_URL=https://login.microsoftonline.com/your_tenant_id/v2.0/.well-known/openid-configuration

# Enterprise integrations (Phase 3)
AZURE_STORAGE_CONNECTION_STRING=your_blob_storage_connection_string
AZURE_STORAGE_CONTAINER=uploads
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Datadog LLM Observability
DD_LLMOBS_ENABLED=true
DD_API_KEY=your_datadog_api_key
DD_SITE=us3.datadoghq.com
DD_ENV=production
DD_SERVICE=owleyes-api
DD_LLMOBS_ML_APP=owleyes-ai
DD_LLMOBS_AGENTLESS_ENABLED=true
DD_LLMOBS_PROJECT_NAME=bead-platform

# Optional: Email/Logging Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password

# Supabase Configuration (frontend - public safe)
NEXT_PUBLIC_SUPABASE_URL=https://vqawanftlolsplxuwipw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_KCIF4MY_KWhI947PtnAPYg__AXV6tYa

# Supabase Configuration (backend - sensitive)
SUPABASE_URL=https://vqawanftlolsplxuwipw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
